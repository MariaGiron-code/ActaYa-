# Copia este archivo a ".env" y completa los valores reales.
# Nunca subas el archivo ".env" al repositorio (ya está en .gitignore).

# Supabase (ADR-01)
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Sentry (ADR-03) - DSN público, es seguro exponerlo en el cliente.
EXPO_PUBLIC_SENTRY_DSN=https://xxxx@o0.ingest.sentry.io/0

# ---------------------------------------------------------------------------
# Los siguientes secretos NO van en este archivo ni en el bundle del cliente.
# Se configuran como secretos del proyecto Supabase y los usan únicamente
# las Edge Functions en supabase/functions/* (ADR-11):
#   supabase secrets set DATACIL_API_KEY=...
#   supabase secrets set QUICKEMAILVERIFICATION_API_KEY=...
# ---------------------------------------------------------------------------
